{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pricing.schema.json",
  "title": "Pricing plans",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "price_usd", "billing_unit", "sessions_included", "features", "highlighted"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "name": { "type": "string", "minLength": 2, "maxLength": 40 },
      "price_usd": { "type": "number", "minimum": 0, "maximum": 10000 },
      "billing_unit": { "type": "string", "enum": ["per-session", "per-month", "one-time"] },
      "sessions_included": { "type": "integer", "minimum": 1, "maximum": 100 },
      "features": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": { "type": "string", "minLength": 2, "maxLength": 80 }
      },
      "highlighted": { "type": "boolean" }
    }
  }
}
