{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "testimonials.schema.json",
  "title": "Student testimonials",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "student_name", "track", "quote", "rating"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "student_name": { "type": "string", "minLength": 2, "maxLength": 60 },
      "track": { "type": "string", "enum": ["python", "system-design"] },
      "quote": { "type": "string", "minLength": 10, "maxLength": 300 },
      "rating": { "type": "integer", "minimum": 1, "maximum": 5 }
    }
  }
}
