{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "instructors.schema.json",
  "title": "Instructor roster",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "role", "bio", "credentials", "specialties", "initials"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "name": { "type": "string", "minLength": 2, "maxLength": 60 },
      "role": { "type": "string", "minLength": 2, "maxLength": 80 },
      "bio": { "type": "string", "minLength": 20, "maxLength": 500 },
      "credentials": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": { "type": "string", "minLength": 2, "maxLength": 80 }
      },
      "specialties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "enum": ["python", "system-design"] }
      },
      "initials": {
        "type": "string",
        "pattern": "^[A-Z]{2}$",
        "description": "Two-letter avatar initials, used since no photo assets exist"
      }
    }
  }
}
